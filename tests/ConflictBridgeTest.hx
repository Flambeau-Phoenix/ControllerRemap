import controllerremap.Remap;
import controllerremap.NativeBindings.NativeBind;
import lib.Input;

class ConflictBridgeTest {
    static var checks=0;
    static function check(ok:Bool,why:String):Void {checks++;if(!ok)throw why;}
    static function bind(button:String,key:Null<Int>=null,mode:Null<Int>=null,modifier:Null<Int>=null):NativeBind return {code:key,modifier:modifier,mode:mode,padCode:button==null?null:HlxRuntime.resolveStaticField("gamepad.PadInputCode",button)};
    static function pad(button:String,mod=-1,mode=-1):controllerremap.Profile.ProfilePad return {pad:button,mod:mod,mode:mode};
    static function main():Void {
        Input.defaultBinds.set("Jump",[bind(null,32),bind("A")]);
        Input.defaultBinds.set("Attack",[bind(null,81),bind("X"),bind("Y")]);
        Input.defaultBinds.set("Menu_LeftClick",[bind("A")]);Input.defaultBinds.set("Menu_Back",[bind("B")]);
        Input.defaultBinds.set("WeaponMode",[bind("RT")]);Input.defaultBinds.set("ClassMode",[bind("LT")]);
        Input.defaultBinds.set("WeaponSkill1",[bind(null,49),bind("DpadUp",null,0)]);
        Input.defaultBinds.set("Skill1",[bind(null,53),bind("DpadUp",null,1)]);
        Input.defaultBinds.set("Interact",[bind("A",null,null,3)]);
        Input.userBinds.set("Jump",[bind(null,74)]);
        Remap.start(1);check(Remap.ready,"bridge ready");
        var keyboard=Remap.keyboardSignature("Jump");
        check(!Remap.requestEdit("Jump",[pad("X")])&&Remap.pendingEdit!=null,"request previews conflict");
        check(Remap.bindState==3,"conflicts carry warning severity rather than passive information");
        check(!Remap.dirty&&Remap.readPads("Jump")[0].pad=="A"&&Remap.readPads("Attack")[0].pad=="X","preview changes neither layout nor engine");
        check(!Remap.requestEdit("Attack",[pad("B")])&&Remap.pendingEdit.plan.action=="Jump","second edit cannot replace review");
        Remap.saveProfile("Pending");check(!sys.FileSystem.exists(Remap.PROFILES+"/Pending.json"),"cannot save an unresolved draft");
        Remap.resolveEdit(0);check(Remap.pendingEdit==null&&!Remap.dirty&&Remap.readPads("Jump")[0].pad=="A","cancel preserves original bindings and dirty state");
        Remap.requestEdit("Jump",[pad("X")]);check(Remap.resolveEdit(1),"confirm moves binding");
        check(Remap.readPads("Jump")[0].pad=="X"&&Remap.readPads("Attack").length==1&&Remap.readPads("Attack")[0].pad=="Y","remove only matching owner alternative");
        check(Remap.keyboardSignature("Jump")==keyboard,"keyboard rebind preserved");
        check(Remap.readPads("Menu_LeftClick")[0].pad=="A","gameplay assignment preserves menu context");
        check(Remap.bindState==1&&Remap.bindMessage.indexOf("successfully bound")>=0,"success appears only after verified active application");
        Remap.saveProfile("Move");Remap.clearAll();Remap.loadProfile("Move");
        check(Remap.readPads("Jump")[0].pad=="X"&&Remap.readPads("Attack")[0].pad=="Y","moved ownership persists in profile");
        Remap.clearAll();Remap.requestEdit("Jump",[pad("X")]);
        check(Remap.pendingEdit.plan.swap!=null&&Remap.resolveEdit(2),"one-to-one swap resolution");
        check(Remap.readPads("Jump")[0].pad=="X"&&Remap.readPads("Attack")[0].pad=="A"&&Remap.readPads("Attack")[1].pad=="Y","swap retains unrelated alternatives");
        Remap.clearAll();Remap.requestEdit("Jump",[pad("DpadUp")]);
        check(Remap.pendingEdit==null&&Remap.readPads("Jump")[0].pad=="DpadUp","plain button applies without stealing held-mode bindings");
        check(Remap.readPads("WeaponSkill1")[0].mode==0&&Remap.readPads("Skill1")[0].mode==1,"weapon and class mode bindings survive a direct assignment");
        check(!Remap.resolveEdit(2)&&Remap.pendingEdit==null,"no conflict resolution is offered for distinct holds");
        Input.activeModes=[];Input.heldButtons=["DpadUp"];
        check(Input.isDownPad("Jump")&&!Input.isDownPad("WeaponSkill1")&&!Input.isDownPad("Skill1"),"only reassigned action fires in offline evaluator");
        Remap.clearAll();Remap.requestEdit("Jump",[pad("A",3)]);
        check(Remap.pendingEdit!=null&&Remap.pendingEdit.plan.conflicts.length==1&&Remap.pendingEdit.plan.conflicts[0].action=="Interact","LT+A conflicts only with the existing combat LT+A");
        Remap.resolveEdit(0);check(Remap.readPads("Jump")[0].pad=="A"&&Remap.readPads("Interact")[0].mod==3,"cancel exact chord move keeps plain and held bindings");
        Remap.requestEdit("Jump",[pad("A",3)]);check(Remap.resolveEdit(1),"confirm exact chord ownership transfer");
        check(Remap.readPads("Interact").length==0&&Remap.readPads("Menu_LeftClick")[0].pad=="A","exact chord move preserves menu A");
        Remap.saveProfile("Exact chord");Remap.clearAll();Remap.loadProfile("Exact chord");
        check(Remap.readPads("Jump")[0].mod==3&&Remap.readPads("Interact").length==0&&Remap.readPads("Menu_LeftClick")[0].pad=="A","profile round trip preserves exact chord ownership and separate contexts");
        Remap.clearAll();Remap.setOverride("Attack",[pad("X"),pad("X",3)]);Remap.requestEdit("Jump",[pad("X")]);
        check(Remap.pendingEdit.plan.conflicts.length==1&&Remap.resolveEdit(1),"plain X only moves the exact alternative");
        check(Remap.readPads("Attack").length==1&&Remap.readPads("Attack")[0].mod==3,"combat LT+X survives assigning combat X");
        Remap.clearAll();Remap.setOverride("Interact",[pad("X")]);Remap.requestEdit("Jump",[pad("X")]);
        check(Remap.pendingEdit.plan.conflicts.length==2&&Remap.pendingEdit.plan.swap==null,"multiple exact owners require a move instead of an ambiguous swap");
        check(!Remap.resolveEdit(2)&&Remap.pendingEdit!=null,"ambiguous exact-match swap stays pending");
        check(Remap.resolveEdit(1)&&Remap.readPads("Interact").length==0&&Remap.readPads("Attack").length==1&&Remap.readPads("Attack")[0].pad=="Y","confirm clears every exact owner and keeps other alternatives");
        Remap.clearAll();Remap.requestEdit("Jump",[pad("DpadRight",4)]);
        check(Remap.pendingEdit==null&&Remap.readPads("Jump")[0].mod==4,"nonconflicting chord applies immediately");
        Remap.clearAll();Remap.saveProfile("Failure baseline");Remap.requestEdit("Jump",[pad("X")]);Input.refuseAction="Attack";
        check(!Remap.resolveEdit(1),"native refusal rejects whole ownership transfer");
        check(Remap.currentPads("Jump")[0].pad=="A"&&Remap.currentPads("Attack").length==2&&!Remap.dirty,"refusal restores configured owners and dirty state");
        check(Remap.bindState==-1&&Remap.bindMessage.indexOf("successfully")<0,"failure never claims success");
        Input.refuseAction="";Remap.apply();check(!Remap.applyFailed&&Remap.readPads("Attack")[0].pad=="X","old native layout can be reapplied");
        Remap.requestEdit("Jump",[pad("X")]);Remap.setOverride("Skill1",[pad("DpadDown",-1,1)]);
        check(!Remap.resolveEdit(1)&&Remap.pendingEdit==null&&Remap.currentPads("Jump")[0].pad=="A","reject stale review after external layout change");
        Remap.clearAll();Remap.setEnabled(false);Remap.requestEdit("Jump",[pad("X")]);
        check(Remap.resolveEdit(1)&&Remap.readPads("Jump")[0].pad=="A","disabled transfer changes configuration only");
        check(Remap.bindState==2&&Remap.bindMessage.indexOf("off")>=0,"disabled feedback does not say active success");
        Remap.setEnabled(true);check(Remap.readPads("Jump")[0].pad=="X"&&Remap.readPads("Attack")[0].pad=="Y","enable applies confirmed ownership transfer");
        Remap.clearAll();Remap.setSwap(true);Remap.requestEdit("Menu_Back",[pad("A")]);
        check(Remap.pendingEdit!=null&&Remap.pendingEdit.plan.after[0].pad=="B","conflict review includes scoped A/B switch");
        check(Remap.resolveEdit(2)&&Remap.readPads("Menu_Back")[0].pad=="B"&&Remap.readPads("Menu_LeftClick")[0].pad=="A","scoped A/B conflict swap exchanges effective buttons");
        Remap.clearAll();
        check(!Remap.requestEdit("Missing",[pad("B")])&&!Remap.requestEdit("Jump",[pad("Alien")]),"invalid requests rejected");
        check(!Remap.requestEdit("Jump",[pad("B"),pad("B")])&&Remap.pendingEdit==null,"duplicate alternatives do not alter bindings");
        check(Remap.requestEdit("Jump",[])&&Remap.readPads("Jump").length==0,"explicit action unbind works");
        check(Remap.bindMessage.indexOf("cleared")>=0,"clear gets accurate feedback");
        Remap.clearAll();Remap.setOverride("Jump",[pad("X")]);Remap.saveProfile("Legacy duplicate");
        check(!Remap.requestEdit("Jump",[pad("X")])&&Remap.pendingEdit!=null,"reselecting an already-assigned duplicate still offers repair");
        check(Remap.resolveEdit(1)&&Remap.readPads("Attack").length==1&&Remap.readPads("Attack")[0].pad=="Y","repair duplicates loaded from older profiles");
        Sys.println("PASS "+checks+" conflict bridge and feedback checks (offline engine fixture)");
    }
}

import controllerremap.Remap;
import controllerremap.NativeBindings;
import controllerremap.NativeBindings.NativeBind;
import lib.Input;
@:access(controllerremap.Remap)
class EngineOverrideTest {
    static var checks=0;
    static function check(ok:Bool,why:String){checks++;if(!ok)throw why;}
    static function bind(button:String,code:Null<Int>=null,mode:Null<Int>=null):NativeBind return {code:code,padCode:button==null?null:HlxRuntime.resolveStaticField("gamepad.PadInputCode",button),modifier:null,mode:mode};
    static function main(){
        var space=bind(null,32),userKey=bind(null,74),a=bind("A"),x=bind("X");
        var jump:Array<NativeBind>=[space,a],attack:Array<NativeBind>=[bind(null,81),x],mode:Array<NativeBind>=[bind("RT")];
        Input.defaultBinds.set("Jump",jump);Input.defaultBinds.set("Attack",attack);Input.defaultBinds.set("WeaponMode",mode);
        var menu:Array<NativeBind>=[bind("B")];Input.defaultBinds.set("Menu_Back",menu);
        var user:Array<NativeBind>=[userKey];Input.userBinds.set("Jump",user);
        var originalCache=Input.bindingsPerMode;
        // Reproduce Claude's failure: later controller entries in userBinds are ignored.
        var oldAttempt:Array<NativeBind>=[userKey,bind("B")];Input.userBinds.set("Jump",oldAttempt);
        check(Remap.readPads("Jump")[0].pad=="A","old userBinds approach reproduces refusal");Input.userBinds.set("Jump",user);
        Remap.start(1);check(Remap.ready,"input inventory ready");
        Remap.setOverride("Jump",[{pad:"DpadUp",mod:5,mode:-1}]);
        check(!Remap.applyFailed&&Remap.appliedCount==1,"native override read-back passes");
        var read=Remap.readPads("Jump");check(read.length==1&&read[0].pad=="DpadUp"&&read[0].mod==5,"RT + arrow override reaches effective binding list");
        var actual=Input.getBindings("Jump");check(HlxRuntime.resolveField(actual.getDyn(0),"code")==74,"user keyboard rebind unchanged");
        check(Input.userBinds.get("Jump")==user,"user bindings map untouched");
        Remap.setEnabled(false);check(Input.defaultBinds.get("Jump")==jump&&Input.bindingsPerMode==originalCache,"toggle off restores exact originals and cache");
        check(Remap.readPads("Jump")[0].pad=="A","native controller binding restored");
        Remap.setEnabled(true);check(Remap.readPads("Jump")[0].pad=="DpadUp","toggle on reapplies custom controller layout");
        Remap.setOverride("Attack",[{pad:"DpadRight",mod:-1,mode:0}]);
        var cache:hl.types.ArrayBase=cast Input.bindingsPerMode.get(0);
        check(cache!=null&&cache.length==1,"weapon-mode cache rebuilt");
        check(HlxRuntime.resolveField(cache.getDyn(0),"padCode")!=null,"mode cache contains new controller binding");
        Remap.setOverride("WeaponMode",[{pad:"RB",mod:-1,mode:-1}]);
        check(!Remap.applyFailed&&Remap.readPads("WeaponMode")[0].pad=="RB","pad-only mode selector remapped");
        Remap.setOverride("Jump",[]);check(!Remap.applyFailed&&Remap.readPads("Jump").length==0,"cleared pad action applies");
        Remap.saveProfile("Controller Test");check(!Remap.dirty,"profile saved");
        Remap.saveProfile("Controller Test");check(!Remap.dirty,"existing profile atomically overwritten");
        Remap.clearAll();check(Input.defaultBinds.get("Jump")==jump&&Input.defaultBinds.get("Attack")==attack&&Input.defaultBinds.get("WeaponMode")==mode,"restore all restores every original");
        Remap.loadProfile("Controller Test");check(!Remap.applyFailed&&Remap.readPads("Jump").length==0,"profile reload restores explicit cleared binding");
        check(Remap.readPads("WeaponMode")[0].pad=="RB","profile reload reapplies mode selector");
        Remap.setSwap(true);check(Remap.readPads("Menu_Back")[0].pad=="A","A/B swap changes menu cancel only");
        check(Remap.currentPads("Menu_Back")[0].pad=="B","editor reads pre-swap binding so Apply does not swap twice");
        check(Remap.readPads("Jump").length==0,"A/B swap leaves gameplay overrides alone");
        Remap.setOverride("Menu_Back",[{pad:"A",mod:-1,mode:-1}]);check(Remap.readPads("Menu_Back")[0].pad=="B","A/B swap composes with explicit menu override");
        Input.refuseAction="Attack";Remap.apply();check(Remap.applyFailed&&Remap.appliedCount==0,"read-back failure rolls back the entire override");
        check(Input.defaultBinds.get("Jump")==jump&&Input.defaultBinds.get("Attack")==attack,"failure restores native arrays");
        Input.refuseAction="";Remap.setEnabled(false);
        var extraKey=bind(null,75);
        var unusual:Array<NativeBind>=[bind("A"),extraKey];
        Input.defaultBinds.set("Jump",unusual);
        Remap.setOverride("Jump",[{pad:"B",mod:-1,mode:-1}]);Remap.setEnabled(true);
        actual=Input.getBindings("Jump");
        check(actual.length==3&&HlxRuntime.resolveField(actual.getDyn(0),"code")==74&&HlxRuntime.resolveField(actual.getDyn(1),"code")==75,"every keyboard alternative preserved even with pad-first native array");
        Remap.setEnabled(false);check(Input.defaultBinds.get("Jump")==unusual,"unusual native order restored exactly");
        var replacement=new hlx.std.haxe.ds.StringMap();
        replacement.set("Jump",jump);replacement.set("Attack",attack);replacement.set("WeaponMode",mode);replacement.set("Menu_Back",menu);
        Input.defaultBinds=replacement;Remap.setEnabled(true);Remap.poll(20);
        check(!Remap.applyFailed&&Remap.readPads("Jump")[0].pad=="B","engine table refresh reapplies requested layout");
        Remap.setEnabled(false);check(replacement.get("Jump")==jump,"disable restores refreshed native table");
        Remap.clearAll();Remap.setEnabled(true);
        Remap.setOverride("Jump",[{pad:"B",mod:-1,mode:-1}]);
        Remap.setOverride("Attack",[{pad:"DpadUp",mod:5,mode:-1}]);
        Remap.saveProfile("Persist Both");
        Remap.setOverride("Jump",[{pad:"Y",mod:-1,mode:-1}]);Remap.saveProfile("Persist Both");
        var saved=haxe.Json.parse(sys.io.File.getContent(Remap.PROFILES+"/Persist Both.json"));
        var savedActions:Array<Dynamic>=saved.actions;check(savedActions.length==2,"saving another action preserves earlier custom bindings");
        Remap.setEnabled(false);
        Remap.ready=false;Remap.activeProfile="";Remap.overrides=new Map();Remap.nextTry=0;Remap.nextCheck=0;
        Remap.start(100);
        check(Remap.ready&&!Remap.enabled&&Remap.activeProfile=="Persist Both","selected controller profile and disabled state survive restart");
        check(Remap.currentPads("Jump")[0].pad=="Y"&&Remap.currentPads("Attack")[0].mod==5,"both latest custom bindings survive restart");
        Remap.setEnabled(true);check(!Remap.applyFailed&&Remap.readPads("Jump")[0].pad=="Y"&&Remap.readPads("Attack")[0].pad=="DpadUp","re-enabling after restart applies the saved controller profile");
        var beforeDelete=Remap.text(Remap.readPads("Jump"))+Remap.text(Remap.readPads("Attack"));
        check(Remap.deleteProfile("Controller Test"),"delete inactive saved profile");
        check(!sys.FileSystem.exists(Remap.PROFILES+"/Controller Test.json")&&Remap.activeProfile=="Persist Both","inactive deletion preserves selected profile");
        check(!Remap.deleteProfile("../Persist Both"),"reject deletion path traversal");
        check(!Remap.deleteProfile("Missing"),"missing deletion is reported");
        sys.FileSystem.createDirectory(Remap.PROFILES+"/Blocked.json");
        check(!Remap.deleteProfile("Blocked"),"do not delete directories");
        check(Remap.deleteProfile("Persist Both"),"delete active saved profile");
        check(Remap.activeProfile==""&&Remap.dirty,"active deletion keeps layout as unsaved edits");
        check(!sys.FileSystem.exists(Remap.PROFILES+"/Persist Both.json")&&Remap.profiles.indexOf("Persist Both")<0,"deleted profile disappears from disk and list");
        check(beforeDelete==Remap.text(Remap.readPads("Jump"))+Remap.text(Remap.readPads("Attack")),"deleting a file does not change live bindings");
        var settings=haxe.Json.parse(sys.io.File.getContent(Remap.DIR+"/settings.json"));check(settings.profile=="","deleting active profile clears startup selection");
        Remap.saveProfile("Saved Again");check(!Remap.dirty&&Remap.activeProfile=="Saved Again","deleted active layout can be saved under a new name");
        Remap.clearAll();Remap.setEnabled(true);
        Remap.setOverride("Jump",[{pad:"B",mod:-1,mode:-1},{pad:"DpadUp",mod:5,mode:0}]);
        Remap.setOverride("Attack",[{pad:"Y",mod:4,mode:1}]);
        var jumpLayout=Remap.text(Remap.layoutPads("Jump")),attackLayout=Remap.text(Remap.layoutPads("Attack"));
        check(Remap.swapActions("Jump","Attack"),"swap two complete controller layouts");
        check(Remap.text(Remap.readPads("Jump"))==attackLayout&&Remap.text(Remap.readPads("Attack"))==jumpLayout,"swap preserves all alternatives and modifier/mode pairs");
        check(HlxRuntime.resolveField(Input.getBindings("Jump").getDyn(0),"code")==74,"swap leaves keyboard rebind alone");
        check(Remap.swapActions("Jump","Attack")&&Remap.text(Remap.readPads("Jump"))==jumpLayout,"swapping twice restores the configured layout");
        Remap.setOverride("Attack",[]);check(Remap.swapActions("Jump","Attack")&&Remap.readPads("Jump").length==0,"swap supports a cleared binding");
        Remap.setEnabled(false);var nativeBefore=Remap.text(Remap.readPads("Jump"))+Remap.text(Remap.readPads("Attack"));
        check(Remap.swapActions("Jump","Attack")&&nativeBefore==Remap.text(Remap.readPads("Jump"))+Remap.text(Remap.readPads("Attack")),"swap while disabled changes layout only");
        Remap.setEnabled(true);check(!Remap.applyFailed&&Remap.text(Remap.readPads("Jump"))==jumpLayout,"disabled swap applies when overrides resume");
        Remap.clearAll();Remap.setOverride("Jump",[{pad:"X",mod:-1,mode:-1}]);Remap.setSwap(true);
        check(Remap.swapActions("Jump","Menu_Back"),"swap across menu and gameplay actions with A/B switch on");
        check(Remap.readPads("Jump")[0].pad=="A"&&Remap.readPads("Menu_Back")[0].pad=="X","swap exchanges visible bindings without double-applying A/B");
        Remap.saveProfile("Swapped Layout");Remap.clearAll();Remap.loadProfile("Swapped Layout");
        check(Remap.readPads("Jump")[0].pad=="A"&&Remap.readPads("Menu_Back")[0].pad=="X"&&Remap.swapAB,"swapped bindings persist in profiles");
        var beforeFailedSwap=Remap.text(Remap.layoutPads("Jump"))+Remap.text(Remap.layoutPads("Menu_Back"));
        check(!Remap.swapActions("Jump","Jump")&&!Remap.swapActions("Missing","Jump"),"reject same-action and unknown swaps");
        Input.refuseAction="Jump";check(!Remap.swapActions("Jump","Menu_Back"),"failed native swap is rejected");
        check(beforeFailedSwap==Remap.text(Remap.layoutPads("Jump"))+Remap.text(Remap.layoutPads("Menu_Back")),"failed swap preserves the previous configured layout");
        Input.refuseAction="";Remap.apply();check(!Remap.applyFailed,"previous layout can be reapplied after a swap refusal");
        Sys.println("PASS "+checks+" HashLink engine bridge checks (offline engine fixture)");
    }
}
